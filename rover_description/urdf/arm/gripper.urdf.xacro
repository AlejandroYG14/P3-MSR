<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- GRIPPER  (base fija + 2 dedos prismaticos)
       Padre: gripper_tras_link  (definido en scara.urdf.xacro) -->

  <!-- Base del gripper -->
  <joint name="gripper_base_link_joint" type="fixed">
    <origin xyz="0 0.02566 -2.01390" rpy="0 0 0"/>
    <parent link="gripper_tras_link"/>
    <child  link="gripper_base_link"/>
  </joint>

  <link name="gripper_base_link">
    <visual name="gripper_base">
      <material name="None"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/dae/Cube.007.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="gripper_base_collision">
      <origin xyz="0 0 -0.02801" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.30 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00385" ixy="0" ixz="0"
               iyy="0.03385" iyz="0"
               izz="0.03750"/>
    </inertial>
  </link>

  <!-- Dedo izquierdo (prismatico, se mueve en X+) -->
  <joint name="joint_left_finger" type="prismatic">
    <origin xyz="-0.45 0 -0.04818" rpy="0 0 0"/>
    <parent link="gripper_base_link"/>
    <child  link="left_finger_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.20" effort="1000.0" velocity="100.0"/>
  </joint>

  <link name="left_finger_link">
    <visual name="dedo1">
      <material name="None"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/dae/Cube.006.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="dedo1_collision">
      <origin xyz="0 0 -0.20810" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.30 0.40"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.00417" ixy="0" ixz="0"
               iyy="0.00271" iyz="0"
               izz="0.00154"/>
    </inertial>
  </link>

  <!-- Dedo derecho (prismatico, se mueve en X-) -->
  <joint name="joint_right_finger" type="prismatic">
    <origin xyz="0.45 0 -0.04818" rpy="0 0 0"/>
    <parent link="gripper_base_link"/>
    <child  link="right_finger_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.20" upper="0.0" effort="1000.0" velocity="100.0"/>
  </joint>

  <link name="right_finger_link">
    <visual name="dedo2">
      <material name="None"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/dae/Cube.008.dae"
              scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="dedo2_collision">
      <origin xyz="0 0 -0.20659" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.30 0.40"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.00417" ixy="0" ixz="0"
               iyy="0.00271" iyz="0"
               izz="0.00154"/>
    </inertial>
  </link>

</robot>

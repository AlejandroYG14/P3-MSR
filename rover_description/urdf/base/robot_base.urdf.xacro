<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find rover_description)/urdf/utils/utils.urdf.xacro"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.73272" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child  link="base_link"/>
  </joint>

  <link name="base_link"/>

  <joint name="base_to_chassis_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 -1.5708"/> 
    <parent link="base_link"/>
    <child  link="chassis_link"/>
  </joint>

  <link name="chassis_link">
    <visual name="Base">
      <material name="Material">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/dae/Cylinder.011.dae" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision name="Base_collision">
      <origin xyz="0 0 -0.06251" rpy="0 0 0"/>
      <geometry>
        <box size="1.5 3.5 0.45"/>
      </geometry>
    </collision>
    <collision name="Base_collision_front_wall">
      <origin xyz="0 -0.47508 0.51045" rpy="0 0 0"/>
      <geometry><box size="1.5 0.05 0.70"/></geometry>
    </collision>
    <collision name="Base_collision_rear_wall">
      <origin xyz="0 -1.72 0.51045" rpy="0 0 0"/>
      <geometry><box size="1.5 0.05 0.70"/></geometry>
    </collision>
    <collision name="Base_collision_left_wall">
      <origin xyz="-0.725 -1.1 0.51045" rpy="0 0 1.5708"/>
      <geometry><box size="1.2 0.05 0.70"/></geometry>
    </collision>
    <collision name="Base_collision_right_wall">
      <origin xyz="0.725 -1.1 0.51045" rpy="0 0 1.5708"/>
      <geometry><box size="1.2 0.05 0.70"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 -0.11566 0.05374" rpy="0 0 0"/>
      <mass value="70.0"/>
      <inertia ixx="93.95663" ixy="-0.00000" ixz="0.00000"
               iyy="39.45127" iyz="22.95778"
               izz="78.82027"/>
    </inertial>
  </link>

  <joint name="pedestal_link_joint" type="fixed">
    <origin xyz="0 1.0 0.16045" rpy="0 0 0"/>
    <parent link="chassis_link"/>
    <child  link="pedestal_link"/>
  </joint>

  <link name="pedestal_link">
    <visual name="pedestal">
      <material name="None"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/dae/Cylinder.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="pedestal_collision">
      <origin xyz="0 0 1.00088" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.2" length="2.0"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 1.0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="1.71635" ixy="0" ixz="0"
               iyy="1.71635" iyz="0"
               izz="0.09936"/>
    </inertial>
  </link>

</robot>